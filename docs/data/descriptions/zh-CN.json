{
  "items": [
    { "id": "d1", "text": "约他七点，他七点才起床" },
    { "id": "d2", "text": "群里最活跃，私聊永远不回" },
    { "id": "d3", "text": "健身卡办了一年，去过两次" },
    { "id": "d4", "text": "工资还没到账就已经花光" },
    { "id": "d5", "text": "天天说“我没复习”，结果次次满分" },
    { "id": "d6", "text": "说到楼下了，其实还在家" },
    { "id": "d7", "text": "全世界都在等他一个" },
    { "id": "d8", "text": "吃之前一定要拍十张照片" },
    { "id": "d9", "text": "看完菜单直接全点" },
    { "id": "d10", "text": "这顿还没吃完就在想下顿" },
    { "id": "d11", "text": "一放假就人间蒸发" },
    { "id": "d12", "text": "计划一大堆，完成的为零" },
    { "id": "d13", "text": "凌晨两点还在发邮件" },
    { "id": "d14", "text": "生日聚会都要接电话开会" },
    { "id": "d15", "text": "谈恋爱之后就失联" },
    { "id": "d16", "text": "一提到对象就停不下来" },
    { "id": "d17", "text": "一开口就得罪全场" },
    { "id": "d18", "text": "怼完人还问“我说错什么了？”" },
    { "id": "d19", "text": "已读不回，但朋友圈秒赞" },
    { "id": "d20", "text": "借东西永远不记得还" }
  ]
}
