{
  "items": [
    { "id": "d1", "text": "約佢七點，佢七點先起身" },
    { "id": "d2", "text": "群組最活躍，私訊永遠唔覆" },
    { "id": "d3", "text": "健身卡辦咗一年，去過兩次" },
    { "id": "d4", "text": "份糧未出已經洗晒" },
    { "id": "d5", "text": "成日話「我冇溫書㗎」，但係次次100分" },
    { "id": "d6", "text": "話到樓下，其實仲喺屋企" },
    { "id": "d7", "text": "全世界都等佢一個" },
    { "id": "d8", "text": "食之前一定要影十張相" },
    { "id": "d9", "text": "睇完餐牌叫晒全部" },
    { "id": "d10", "text": "未食完呢餐已經諗緊下餐" },
    { "id": "d11", "text": "一放假就人間蒸發" },
    { "id": "d12", "text": "計劃好多，做到嘅零" },
    { "id": "d13", "text": "凌晨兩點仲 send email" },
    { "id": "d14", "text": "生日會都要接電話開會" },
    { "id": "d15", "text": "拍拖之後就失蹤" },
    { "id": "d16", "text": "一講起佢就停唔到口" },
    { "id": "d17", "text": "一開口就得罪晒全場" },
    { "id": "d18", "text": "寸完人仲問「我講錯咩？」" },
    { "id": "d19", "text": "已讀不回，但限時動態秒睇" },
    { "id": "d20", "text": "借嘢永遠唔記得還" }
  ]
}
